{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "proseWrap": "preserve",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "target/**",
    "apps/server/static/**",
    "apps/server/config/**",
    "apps/server/config.json",
    "Cargo.lock",
    "pnpm-lock.yaml",
    "assets/**",
    "LICENSE"
  ]
}
